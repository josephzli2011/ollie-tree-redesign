---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import GivingPlaceholder from '../../../components/GivingPlaceholder.astro';
import { pageByPath, load } from '../../../lib/home';
import { picHtml } from '../../../lib/pic';

const page = await pageByPath('/cn/奉献2/');
// The old page's own copy (Zelle, check, transparency promise) stays; its form/PayPal widgets become the mock-up above.
const $ = load(page.html);
$('.form-placeholder').remove();
$('button').remove(); // the old form's Cancel/Next buttons did nothing without the form
const body = picHtml($.html());
---
<BaseLayout title="捐款 Donation" lang="zh-CN" site="cn">
  <PageHeader title="捐款 Donation" site="cn" path="/cn/奉献2/" eyebrow="奉献" />
  <div class="container" style="padding-block: var(--space-7)">
    <GivingPlaceholder site="cn" />
    <article class="prose giving-copy" lang="zh-CN" set:html={body} />
  </div>
</BaseLayout>

<style>
  .giving-copy { margin-top: var(--space-8); }
</style>
