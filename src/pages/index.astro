---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageByPath, load } from '../lib/home';
import { url } from '../lib/url';
import { LABELS, ORG } from '../lib/site';
import '../styles/home.css';

const root = await pageByPath('/');
const $ = load(root.html);
const welcome = $('h1').first().html() ?? '';
const photos = $('img').toArray().map((i) => $(i).attr('src')!).slice(0, 5);
const sites = [
  { key: 'cn', label: '中文站', lang: 'zh-CN', ...LABELS.cn },
  { key: 'en', label: 'English Site', lang: 'en', ...LABELS.en },
];
---
<BaseLayout title="" lang="zh-CN" site="root">
  <section class="chooser">
    <div class="photos" aria-hidden="true">
      {photos.map((p) => <img src={p} alt="" />)}
    </div>
    <div class="panel">
      <img class="logo" src={url(ORG.logo)} alt="OllieTree Foundation 橄榄树基金会" width="263" height="240" />
      <h1 set:html={welcome} />
      <div class="choices">
        {sites.map((s) => (
          <a class="choice" href={url(`/${s.key}/`)} lang={s.lang}>
            <span class="label">{s.label}</span>
            <span class="name">{s.name}</span>
            <span class="tag">{s.tagline}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chooser { position: relative; min-height: 100vh; display: grid; place-items: center; padding: var(--space-6) 1.25rem; overflow: hidden; background: var(--color-olive-900); }
  .photos { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); opacity: 0.35; }
  .photos img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8); }
  .panel { position: relative; width: min(100%, 46rem); background: var(--color-cream); border-radius: var(--radius-lg); padding: var(--space-7) var(--space-6); text-align: center; box-shadow: 0 20px 60px rgb(0 0 0 / 0.35); }
  .logo { width: 120px; height: auto; margin: 0 auto var(--space-4); display: block; }
  h1 { font-size: var(--text-2xl); margin-bottom: var(--space-6); }
  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .choice {
    position: relative; display: flex; flex-direction: column; gap: var(--space-1); text-align: left;
    padding: var(--space-5); border-radius: var(--radius-md); border: 2px solid var(--color-line); background: #fff;
    color: var(--color-ink); text-decoration: none; transition: border-color 0.15s, transform 0.15s;
  }
  .choice:hover { border-color: var(--color-olive-700); transform: translateY(-2px); color: var(--color-ink); }
  .label { font-size: var(--text-xl); font-weight: 800; color: var(--color-olive-900); }
  .name { font-weight: 700; }
  .tag { color: var(--color-ink-soft); font-size: var(--text-sm); padding-right: 1.5rem; }
  .go { position: absolute; right: var(--space-5); bottom: var(--space-5); font-size: 1.5rem; color: var(--color-olive-700); }
  @media (max-width: 600px) { .choices { grid-template-columns: 1fr; } .photos { grid-template-columns: repeat(2, 1fr); } }
</style>
