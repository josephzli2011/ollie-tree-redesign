---
import '../styles/base.css';
import '../styles/prose.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LABELS, ORG, type Site } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title: string;
  lang: 'zh-CN' | 'en';
  site: Site | 'root';
  description?: string;
}
const { title, lang, site, description } = Astro.props;
const labelSite: Site = site === 'en' ? 'en' : 'cn';
const L = LABELS[labelSite];
const FONTS = 'https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap';
const fullTitle =title && title !== L.name ? `${title} | ${L.name}` : `${L.name} | ${L.altName}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? `${L.name} ${L.altName} — ${L.tagline}`} />
    <link rel="icon" href={url(ORG.logo)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS} />
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{L.skip}</a>
    {site !== 'root' && <Header site={labelSite} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {site !== 'root' && <Footer site={labelSite} />}
    <dialog class="lightbox" aria-label="Image viewer">
      <button class="lightbox-close" type="button" aria-label={L.close}>×</button>
      <button class="lightbox-prev" type="button" aria-label="Previous">‹</button>
      <img alt="" />
      <button class="lightbox-next" type="button" aria-label="Next">›</button>
    </dialog>
    <script>
      // Click any content image to view it larger; arrows step through the page's images.
      const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
      const big = dialog.querySelector('img')!;
      const imgs = [...document.querySelectorAll<HTMLImageElement>('.prose img')].filter((i) => !i.closest('a'));
      let at = 0;
      const show = (i: number) => {
        at = (i + imgs.length) % imgs.length;
        big.src = imgs[at].dataset.full || imgs[at].currentSrc || imgs[at].src;
        big.alt = imgs[at].alt;
      };
      const zoomLabel = document.documentElement.lang === 'en' ? 'View larger image' : '查看大图';
      imgs.forEach((img, i) => {
        // wrap each image in a real button so it is keyboard- and screen-reader-operable
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'zoom';
        btn.setAttribute('aria-label', img.alt ? `${zoomLabel}: ${img.alt}` : zoomLabel);
        img.replaceWith(btn);
        btn.append(img);
        img.dataset.zoom = '';
        btn.addEventListener('click', () => { show(i); dialog.showModal(); });
      });
      dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close());
      dialog.querySelector('.lightbox-prev')!.addEventListener('click', () => show(at - 1));
      dialog.querySelector('.lightbox-next')!.addEventListener('click', () => show(at + 1));
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(at - 1);
        if (e.key === 'ArrowRight') show(at + 1);
      });
    </script>
    <style>
      .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; overflow: visible; }
      .lightbox::backdrop { background: rgb(10 20 15 / 0.88); }
      .lightbox img { display: block; max-width: 92vw; max-height: 86vh; border-radius: var(--radius-md); }
      .lightbox button {
        position: fixed; width: 52px; height: 52px; border-radius: 50%; border: 0;
        background: rgb(255 255 255 / 0.92); color: var(--color-olive-900); font-size: 2rem; line-height: 1; cursor: pointer;
      }
      .lightbox-close { top: 1rem; right: 1rem; }
      .lightbox-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
      .lightbox-next { right: 1rem; top: 50%; transform: translateY(-50%); }
      main:focus { outline: none; }
    </style>
  </body>
</html>
